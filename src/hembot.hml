// Hembot — an interactive Hemlock coding agent.
// Talks to a local llama-server (OpenAI-compatible /v1/chat/completions),
// extracts Hemlock code from responses, runs it in a sandbox,
// and optionally feeds errors back for self-correction.

import { post_json_timeout, post_json_stream, HttpServer } from "@stdlib/http";
import { parse as json_parse, stringify as json_stringify } from "@stdlib/json";
import { read_file, write_file, exists, remove_file } from "@stdlib/fs";
import { run_capture_safe } from "@stdlib/shell";
import { time_ms } from "@stdlib/time";
import { BOLD, DIM, CYAN, GREEN, RED, RESET } from "@stdlib/terminal";

import { extract_code, build_retry_feedback, parse_sse_events, parse_openai_delta, categorize_error } from "./extract.hml";
import { load_config, parse_cli } from "./config.hml";
import { pick_strategy, temperature_for, STRATEGY_FEEDBACK, STRATEGY_COLD } from "./strategy.hml";
import { start as spinner_start, stop as spinner_stop, format_summary, format_elapsed } from "./spinner.hml";
import { parse_chat_request, chat_response_json, error_json } from "./api.hml";
import { build_map } from "./project.hml";
import { parse_tools, apply_edits } from "./tools.hml";

// ────────────────────────────────────────────────────────────────────────────
// LLM call — streaming version. Prints each token as it arrives and returns
// the full concatenated response at the end. Falls back to non-streaming
// silently via `chat_blocking` when `config.stream` is false (handy for
// tests and for servers that don't support SSE).

// Spinner shown while the model churns. Pre-colored so spinner.hml stays
// free of terminal coupling. Returns a handle, or null when disabled.
fn begin_wait(config) {
    if (!config.spinner) { return null; }
    return spinner_start(`${DIM}thinking${RESET}`);
}

fn end_wait(handle) {
    if (handle != null) { spinner_stop(handle); }
}

fn chat_blocking(config, messages, label, temperature) {
    let payload = {
        model: config.model,
        messages: messages,
        temperature: temperature,
        max_tokens: config.max_tokens,
    };

    let started = time_ms();
    let sp = begin_wait(config);
    let resp = post_json_timeout(config.url, payload, config.timeout_ms);
    end_wait(sp);
    if (resp.status_code != 200) {
        throw `LLM request failed: HTTP ${resp.status_code}\n${resp.body}`;
    }

    let elapsed = time_ms() - started;
    let content = json_parse(resp.body).choices[0].message.content;
    write(label + content + "\n");
    if (config.spinner) {
        print(`${DIM}── ${format_elapsed(elapsed)} ──${RESET}`);
    }
    return content;
}

fn chat_streaming(config, messages, label, temperature) {
    let payload = {
        model: config.model,
        messages: messages,
        temperature: temperature,
        max_tokens: config.max_tokens,
        stream: true,
    };

    // Spin *before* the request — `post_json_stream` itself blocks through the
    // prompt-processing wait, so the spinner must already be running by then.
    // It's cleared the moment real text arrives.
    let started = time_ms();
    let sp = begin_wait(config);
    let s = post_json_stream(config.url, payload, config.timeout_ms);
    if (s.status_code != 200) {
        end_wait(sp);
        s.close();
        throw `LLM request failed: HTTP ${s.status_code}`;
    }
    let full = "";
    let buffer = "";
    let finished = false;
    let tokens = 0;
    let labeled = false;

    while (!s.done && !finished) {
        let chunk = s.read(config.timeout_ms);
        if (chunk == null) { break; }
        buffer = buffer + chunk;

        let parsed = parse_sse_events(buffer);
        buffer = parsed.remainder;

        for (payload_str in parsed.events) {
            let delta = parse_openai_delta(payload_str, json_parse);
            if (delta.length > 0) {
                if (!labeled) {
                    end_wait(sp);
                    sp = null;
                    write(label);
                    labeled = true;
                }
                write(delta);
                full = full + delta;
                tokens = tokens + 1;
            }
        }

        if (parsed.done) { finished = true; }
    }

    end_wait(sp);  // stream ended before any token arrived
    s.close();
    if (labeled) {
        write("\n");  // terminate the streamed line so the next prompt is on its own row
    }
    if (config.spinner) {
        let elapsed = time_ms() - started;
        print(`${DIM}── ${format_summary(tokens, elapsed)} ──${RESET}`);
    }
    return full;
}

fn chat(config, messages, label, temperature) {
    if (config.stream) {
        return chat_streaming(config, messages, label, temperature);
    }
    return chat_blocking(config, messages, label, temperature);
}

// Non-streaming generation with no terminal output — used by the HTTP API,
// which returns JSON rather than printing to a TTY.
fn generate_quiet(config, messages, temperature) {
    let payload = {
        model: config.model,
        messages: messages,
        temperature: temperature,
        max_tokens: config.max_tokens,
    };
    let resp = post_json_timeout(config.url, payload, config.timeout_ms);
    if (resp.status_code != 200) {
        throw `LLM request failed: HTTP ${resp.status_code}`;
    }
    return json_parse(resp.body).choices[0].message.content;
}

// ────────────────────────────────────────────────────────────────────────────
// Sandbox execution

fn run_hemlock(code) {
    let tmpfile = "/tmp/hembot_snippet.hml";
    write_file(tmpfile, code);
    // argv-style: no shell metacharacters, no warnings, no injection.
    // `timeout` is just another executable that wraps its child, so it
    // works fine inside argv form.
    let result = run_capture_safe(["timeout", "10", "hemlock", tmpfile]);
    let stdout = result.stdout ?? "";
    let stderr = result.stderr ?? "";
    // Merge streams so the user sees syntax/runtime errors too.
    let output = stdout;
    if (stderr.length > 0) {
        if (output.length > 0 && !output.ends_with("\n")) {
            output = output + "\n";
        }
        output = output + stderr;
    }
    return {
        exit_code: result.code,
        output: output,
    };
}

// ────────────────────────────────────────────────────────────────────────────
// UI helpers

fn banner() {
    print(`${BOLD}${CYAN}╔══════════════════════════════════════╗${RESET}`);
    print(`${BOLD}${CYAN}║  Hembot — Hemlock Coding Agent       ║${RESET}`);
    print(`${BOLD}${CYAN}╚══════════════════════════════════════╝${RESET}`);
    print(`${DIM}Type a question. Ctrl-D or 'exit' to quit.${RESET}`);
    print(`${DIM}Slash commands: /reset, /save <file>, /load <file>, /help${RESET}`);
    print("");
}

fn assistant_label(): string {
    return `${GREEN}Hembot:${RESET} `;
}

fn print_error(text) {
    eprint(`${RED}Error:${RESET} ${text}`);
}

fn print_sandbox(result) {
    let tag = result.exit_code == 0
        ? `${GREEN}✓ ran cleanly${RESET}`
        : `${RED}✗ exit ${result.exit_code}${RESET}`;
    print(`${DIM}── sandbox: ${tag}${RESET}`);
    print(result.output);
    print(`${DIM}──${RESET}`);
}

// ────────────────────────────────────────────────────────────────────────────
// Slash commands

fn handle_slash(cmd, messages) {
    let parts = cmd.trim().split(" ");
    let op = parts[0];

    if (op == "/reset") {
        let first = messages[0];  // keep system prompt
        messages.clear();
        messages.push(first);
        print(`${DIM}Conversation reset.${RESET}`);
        return messages;
    }

    if (op == "/save" && parts.length >= 2) {
        write_file(parts[1], json_stringify(messages));
        print(`${DIM}Saved ${messages.length} messages to ${parts[1]}.${RESET}`);
        return messages;
    }

    if (op == "/load" && parts.length >= 2) {
        if (!exists(parts[1])) {
            print_error(`No such file: ${parts[1]}`);
            return messages;
        }
        let loaded = json_parse(read_file(parts[1]));
        print(`${DIM}Loaded ${loaded.length} messages from ${parts[1]}.${RESET}`);
        return loaded;
    }

    if (op == "/help") {
        print(`  /reset         — clear conversation (keeps system prompt)`);
        print(`  /save <file>   — save conversation as JSON`);
        print(`  /load <file>   — load conversation from JSON`);
        print(`  /help          — this message`);
        return messages;
    }

    print_error(`Unknown command: ${op}`);
    return messages;
}

// ────────────────────────────────────────────────────────────────────────────
// Auto-retry with a hybrid strategy (feedback first, then cold resample).
// See src/strategy.hml for the rationale — benchmark-tuned on Apothecary.

fn retry_loop(config, messages, last_result, original_user_prompt) {
    let system_prompt = messages[0];  // preserved across cold resamples
    let error_type = categorize_error(last_result);
    let attempt = 0;
    while (attempt < config.max_retries && last_result.exit_code != 0) {
        attempt = attempt + 1;
        let strategy = pick_strategy(attempt, error_type);
        let temp = temperature_for(attempt, config.temperature, error_type);

        let turn_messages = null;
        if (strategy == STRATEGY_FEEDBACK) {
            // Append feedback to the accumulated conversation so the model
            // sees the previous code + the error.
            let feedback = build_retry_feedback(last_result);
            messages.push({ role: "user", content: feedback });
            turn_messages = messages;
        } else {
            // Cold resample: fresh two-message conversation, bumped temp
            // for diversity. Don't pollute `messages` with failed tries.
            turn_messages = [system_prompt, { role: "user", content: original_user_prompt }];
        }

        print(`${DIM}── retry ${attempt}/${config.max_retries} (${strategy}, error=${error_type}, temp=${temp}) ──${RESET}`);
        let response = null;
        try {
            response = chat(config, turn_messages, assistant_label(), temp);
        } catch (e) {
            print_error(`${e}`);
            if (strategy == STRATEGY_FEEDBACK) { messages.pop(); }
            return;
        }

        // Only append to the persistent conversation on a feedback turn —
        // cold resamples are exploratory, we don't want the model to see
        // them later as "things we've already tried".
        if (strategy == STRATEGY_FEEDBACK) {
            messages.push({ role: "assistant", content: response });
        }

        let code = extract_code(response);
        if (code == null) {
            print(`${DIM}No code in retry response; giving up.${RESET}`);
            return;
        }
        last_result = run_hemlock(code);
        // Recategorize error after each retry
        error_type = categorize_error(last_result);
        print_sandbox(last_result);

        // If a cold resample succeeded, replace the failed feedback trail
        // in the persistent conversation with just the winning reply so
        // future turns see a clean history.
        if (strategy == STRATEGY_COLD && last_result.exit_code == 0) {
            // Drop any feedback-turn bookkeeping left over from attempt 1.
            while (messages.length > 2) { messages.pop(); }
            messages.push({ role: "assistant", content: response });
        }
    }
}

// ────────────────────────────────────────────────────────────────────────────
// HTTP API (serve mode)
//
//   GET  /health  → { "status": "ok", "model": ... }
//   POST /chat    → { "prompt": "...", "execute": true }
//                 ← { "response": ..., "code": ... | null,
//                     "sandbox": { "exit_code": N, "output": ... } | null }
//
// Stateless per request: each call is a fresh [system, user] conversation.

fn json_response(status, body) {
    return { status: status, content_type: "application/json", body: body };
}

fn run_server(config) {
    let system_prompt = read_file(config.system_prompt_file);
    let srv = HttpServer(config.serve_host, config.serve_port);

    // Cute web chat UI at GET / (served when the html file is present).
    let ui_served = false;
    if (config.ui_enabled && exists(config.ui_file)) {
        let page = read_file(config.ui_file);
        ui_served = true;
        srv.route("GET", "/", fn(req) {
            return { status: 200, content_type: "text/html; charset=utf-8", body: page };
        });
    }

    srv.route("GET", "/health", fn(req) {
        return json_response(200, json_stringify({ status: "ok", model: config.model }));
    });

    srv.route("POST", "/chat", fn(req) {
        let parsed = parse_chat_request(req.body, json_parse);
        if (!parsed.ok) {
            return json_response(400, error_json(parsed.error, json_stringify));
        }

        let messages = [
            { role: "system", content: system_prompt },
            { role: "user", content: parsed.prompt },
        ];

        let response = null;
        try {
            response = generate_quiet(config, messages, config.temperature);
        } catch (e) {
            return json_response(502, error_json(`${e}`, json_stringify));
        }

        let code = extract_code(response);
        let sandbox = null;
        if (parsed.execute && code != null) {
            sandbox = run_hemlock(code);
        }
        return json_response(200, chat_response_json(response, code, sandbox, json_stringify));
    });

    let base = `http://${config.serve_host}:${config.serve_port}`;
    print(`${BOLD}${CYAN}Hembot${RESET} on ${DIM}${base}${RESET}`);
    if (ui_served) {
        print(`${GREEN}  🌿 web UI  ${base}/${RESET}`);
    }
    print(`${DIM}  GET  /health${RESET}`);
    print(`${DIM}  POST /chat   {"prompt": "...", "execute": true}${RESET}`);
    print(`${DIM}Ctrl-C to stop.${RESET}`);

    // Resilient accept loop — a malformed/empty request (e.g. a browser
    // preconnect socket that sends no bytes) must not kill the server, so we
    // call handle_one() ourselves and swallow per-request errors rather than
    // using the stdlib's serve(), which lets one bad request take it down.
    loop {
        try {
            srv.handle_one();
        } catch (e) {
            // ignore this request and keep serving
        }
    }
}

// ────────────────────────────────────────────────────────────────────────────
// Project mode — multi-file agent over a whole repo.
//
// The model drives the repo through the tool protocol in src/tools.hml. We
// always show it a repo map (src/project.hml); file bodies arrive on demand via
// @read. Edits land on the real git working tree, so every change is a
// reviewable, revertible diff.

let PROJECT_SYSTEM_PROMPT = `You are Hembot, a coding agent working inside a Hemlock repository. You complete the user's task by issuing tool commands, one step at a time, and reading the results before continuing.

You are shown a repo map (each file's path, exports, and imports). File contents are NOT shown until you @read them.

Respond ONLY with tool commands. Available tools:

@read <path>        — show a file's contents
@grep <pattern>     — search the repo
@tree               — reprint the repo map
@run <path>         — run a .hml file (e.g. a test) and see its output
@delete <path>      — delete a file
@done <summary>     — finish; the task is complete

@write <path>       — create or overwrite a file with full contents:
\`\`\`
<full file content>
\`\`\`

@edit <path>        — change an existing file with one or more search/replace blocks:
\`\`\`
<<<<<<< SEARCH
exact existing lines
=======
replacement lines
>>>>>>> REPLACE
\`\`\`

Rules:
- Prefer @edit over @write for existing files. SEARCH must match the file exactly.
- @read the files you intend to edit before editing them.
- After changing code, @run the relevant test to verify, then fix any failures.
- When everything works, finish with @done. Keep going until the task is done.`;

// Whole-file variant (--whole-file): edits are done by rewriting the entire
// file, which avoids the exact-match failures that trip up weaker models on
// search/replace. Costs more tokens but is far more reliable.
let PROJECT_SYSTEM_PROMPT_WHOLE = `You are Hembot, a coding agent working inside a Hemlock repository. You complete the user's task by issuing tool commands, one step at a time, and reading the results before continuing.

You are shown a repo map (each file's path, exports, and imports). File contents are NOT shown until you @read them.

Respond ONLY with tool commands. Available tools:

@read <path>        — show a file's contents
@grep <pattern>     — search the repo
@tree               — reprint the repo map
@run <path>         — run a .hml file (e.g. a test) and see its output
@delete <path>      — delete a file
@done <summary>     — finish; the task is complete

@write <path>       — create a file, OR replace an existing file's ENTIRE contents:
\`\`\`
<full file content>
\`\`\`

Rules:
- To change an existing file: @read it first, then @write the FULL updated file with your change applied. Reproduce every other line unchanged.
- Always @write the complete file — never a fragment or a diff.
- After changing code, @run the relevant test to verify, then fix any failures.
- When everything works, finish with @done. Keep going until the task is done.`;

// Project-relative full path.
fn proj_path(dir, rel) {
    return `${dir}/${rel}`;
}

// mkdir -p the parent directory of a file path.
fn ensure_parent(fp) {
    let parts = fp.split("/");
    parts.pop();
    let parent = parts.join("/");
    if (parent != "") {
        run_capture_safe(["mkdir", "-p", parent]);
    }
}

// Discover every .hml file in the repo (relative path + content).
fn discover_repo(dir) {
    let res = run_capture_safe(["find", dir, "-name", "*.hml", "-not", "-path", "*/.git/*", "-type", "f"]);
    let files = [];
    for (raw in (res.stdout ?? "").split("\n")) {
        let p = raw.trim();
        if (p == "") { continue; }
        let rel = p;
        if (rel.starts_with(dir + "/")) { rel = rel.slice(dir.length + 1); }
        files.push({ path: rel, content: read_file(p) });
    }
    return files;
}

// Append text to a file (for the trajectory recorder).
fn append_file(path, text) {
    let prior = exists(path) ? read_file(path) : "";
    write_file(path, prior + text);
}

// Run the optional verify command in the project dir. Returns true/false, or
// null when no command was given.
fn run_verify(config, dir) {
    if (config.verify_cmd == null) { return null; }
    let r = run_capture_safe(["sh", "-c", `cd ${dir} && ${config.verify_cmd}`]);
    return r.code == 0;
}

// Execute one tool call against the repo; return a result string for the model.
// `seen` records files the model has @read (or @written) this task, so we can
// refuse to overwrite an existing file blindly.
fn exec_tool(config, dir, tool, repo_map, seen) {
    let kind = tool.tool;

    if (kind == "tree") { return repo_map; }

    if (kind == "read") {
        let fp = proj_path(dir, tool.path);
        if (!exists(fp)) { return `(read ${tool.path}: not found)`; }
        seen[tool.path] = true;
        return `--- ${tool.path} ---\n${read_file(fp)}`;
    }

    if (kind == "grep") {
        let res = run_capture_safe(["grep", "-rn", "--include=*.hml", tool.pattern, dir]);
        let out = (res.stdout ?? "").trim();
        if (out == "") { return `(grep "${tool.pattern}": no matches)`; }
        if (out.length > 1500) { out = out.slice(0, 1500) + "\n…(truncated)"; }
        return out;
    }

    if (kind == "write") {
        let fp = proj_path(dir, tool.path);
        // Guardrail: don't let the model clobber an existing file it hasn't
        // read this task — a weak model may @write a truncated "full file".
        if (exists(fp) && !seen.has(tool.path)) {
            return `(write ${tool.path}: refused — @read it first, then @write the COMPLETE updated file)`;
        }
        ensure_parent(fp);
        write_file(fp, tool.content);
        seen[tool.path] = true;
        return `(wrote ${tool.path}, ${tool.content.split("\n").length} lines)`;
    }

    if (kind == "edit") {
        let fp = proj_path(dir, tool.path);
        if (!exists(fp)) { return `(edit ${tool.path}: file not found — use @write to create it)`; }
        let r = apply_edits(read_file(fp), tool.edits);
        if (!r.ok) { return `(edit ${tool.path} FAILED: ${r.error}. @read the file and match the SEARCH block exactly.)`; }
        write_file(fp, r.content);
        return `(edited ${tool.path})`;
    }

    if (kind == "delete") {
        let fp = proj_path(dir, tool.path);
        if (exists(fp)) { remove_file(fp); return `(deleted ${tool.path})`; }
        return `(delete ${tool.path}: not found)`;
    }

    if (kind == "run") {
        let fp = proj_path(dir, tool.target);
        let res = run_capture_safe(["timeout", "30", "hemlock", fp]);
        let out = (res.stdout ?? "") + (res.stderr ?? "");
        if (out.length > 1800) { out = out.slice(0, 1800) + "\n…(truncated)"; }
        return `(run ${tool.target}, exit ${res.code})\n${out}`;
    }

    if (kind == "done") { return `(done) ${tool.summary}`; }
    return `(unknown tool)`;
}

// Run one task to completion (or until max steps) on the repo.
fn run_project_task(config, dir, task) {
    let files = discover_repo(dir);
    let repo_map = build_map(files);

    let sys_prompt = config.whole_file ? PROJECT_SYSTEM_PROMPT_WHOLE : PROJECT_SYSTEM_PROMPT;
    let messages = [
        { role: "system", content: sys_prompt },
        { role: "user", content: `${repo_map}\n\nTask: ${task}\n\nBegin.` },
    ];

    let seen = {};   // files @read or @written this task (for the overwrite guardrail)
    let step = 0;
    let finished = false;
    while (step < config.max_steps && !finished) {
        step = step + 1;
        let resp = null;
        try {
            resp = generate_quiet(config, messages, config.temperature);
        } catch (e) {
            print_error(`${e}`);
            return;
        }

        print(`${DIM}─── step ${step}/${config.max_steps} ───${RESET}`);
        print(resp);

        let tools = parse_tools(resp);
        messages.push({ role: "assistant", content: resp });

        if (tools.length == 0) {
            messages.push({ role: "user", content: "No tool commands found. Respond only with @read/@grep/@write/@edit/@run/@delete/@done." });
            continue;
        }

        let results = [];
        for (tool in tools) {
            let r = exec_tool(config, dir, tool, repo_map, seen);
            let preview = r.length > 240 ? r.slice(0, 240) + "…" : r;
            print(`${GREEN}↳${RESET} ${DIM}${preview}${RESET}`);
            results.push(r);
            if (tool.tool == "done") { finished = true; }
            if (tool.tool == "write" || tool.tool == "delete") {
                files = discover_repo(dir);
                repo_map = build_map(files);
            }
        }
        messages.push({ role: "user", content: results.join("\n\n") });
    }

    if (!finished) {
        print(`${DIM}(stopped after ${config.max_steps} steps)${RESET}`);
    }
    // `git status -s` so the summary includes untracked (newly created) files,
    // which `git diff` would miss.
    let diff = run_capture_safe(["git", "-C", dir, "status", "-s"]);
    let ds = (diff.stdout ?? "").trim();
    print(`${BOLD}${CYAN}changes:${RESET}`);
    print(ds == "" ? `${DIM}(no changes)${RESET}` : ds);
    print(`${DIM}review with: git -C ${dir} diff   ·   undo with: git -C ${dir} checkout . && git -C ${dir} clean -fd${RESET}`);

    // Record the trajectory as training data: the full conversation (the
    // assistant turns are the agent actions) plus an outcome verdict so we can
    // keep only the trajectories that actually worked.
    if (config.record_file != null) {
        let verified = run_verify(config, dir);
        let success = finished && (verified != false);
        let record = {
            task: task,
            success: success,
            reached_done: finished,
            verified: verified,
            steps: step,
            changed: ds,
            messages: messages,
        };
        append_file(config.record_file, json_stringify(record) + "\n");
        print(`${DIM}recorded trajectory (success=${success}) → ${config.record_file}${RESET}`);
    }
}

fn run_project_repl(config) {
    let dir = config.project_dir;
    if (!exists(dir)) {
        print_error(`No such directory: ${dir}`);
        return;
    }
    print(`${BOLD}${CYAN}Hembot${RESET} ${DIM}project mode${RESET} — ${dir}`);
    print(`${DIM}Type a task. Ctrl-D or 'exit' to quit. Changes land on the git working tree.${RESET}`);
    print("");

    loop {
        write(`${BOLD}task>${RESET} `);
        let input = read_line();
        if (input == null) { print(""); break; }
        let t = input.trim();
        if (t == "") { continue; }
        if (t == "exit" || t == "quit") { break; }
        run_project_task(config, dir, t);
        print("");
    }
    print(`${DIM}Goodbye.${RESET}`);
}

// ────────────────────────────────────────────────────────────────────────────
// Main loop

fn main() {
    let parsed = parse_cli(args);
    let config = load_config(parsed);

    if (!exists(config.system_prompt_file)) {
        print_error(`System prompt file not found: ${config.system_prompt_file}`);
        return;
    }

    if (config.serve) {
        run_server(config);
        return;
    }

    if (config.project_dir != null) {
        run_project_repl(config);
        return;
    }

    let system_prompt = read_file(config.system_prompt_file);
    let messages = [{ role: "system", content: system_prompt }];

    banner();

    loop {
        write(`${BOLD}you>${RESET} `);
        let input = read_line();
        if (input == null) {
            print("");
            break;
        }

        let trimmed = input.trim();
        if (trimmed == "") { continue; }
        if (trimmed == "exit" || trimmed == "quit") { break; }
        if (trimmed.starts_with("/")) {
            messages = handle_slash(trimmed, messages);
            continue;
        }

        messages.push({ role: "user", content: input });

        let response = null;
        try {
            response = chat(config, messages, assistant_label(), config.temperature);
        } catch (e) {
            print_error(`${e}`);
            messages.pop();
            continue;
        }

        messages.push({ role: "assistant", content: response });

        if (config.run_code) {
            let code = extract_code(response);
            if (code != null) {
                let result = run_hemlock(code);
                print_sandbox(result);

                if (config.auto_retry && result.exit_code != 0) {
                    retry_loop(config, messages, result, input);
                }
            }
        }
    }

    print(`${DIM}Goodbye.${RESET}`);
}

main();
