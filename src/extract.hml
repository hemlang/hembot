// Pure helpers for extracting and repairing code from an LLM response.
// Kept as a separate module so they can be unit-tested without spinning up
// a chat server.

// Pull the first ```hemlock / ```hml / ``` fenced block from `response`.
// Returns the trimmed code, or null if no fenced block is found.
export fn extract_code(response) {
    let fence_tags = ["```hemlock", "```hml", "```"];
    for (tag in fence_tags) {
        let start = response.find(tag);
        if (start >= 0) {
            let after = start + tag.length;
            // Skip an optional newline immediately after the opening fence
            if (after < response.length && response.char_at(after) == '\n') {
                after = after + 1;
            }
            let rest = response.slice(after);
            let end = rest.find("```");
            if (end >= 0) {
                return rest.slice(0, end).trim();
            }
        }
    }
    
    // Fallback: if no fenced block found, check if the entire response
    // looks like Hemlock code (starts with fn, let, print, import, define, etc.)
    let trimmed = response.trim();
    if (looks_like_hemlock_code(trimmed)) {
        return trimmed;
    }
    
    return null;
}

// Heuristic to detect if text looks like Hemlock code.
// Returns true if the text starts with common Hemlock keywords/patterns.
fn looks_like_hemlock_code(text) {
    // Common Hemlock starting patterns
    let patterns = [
        "fn ", "let ", "var ", "const ", "import ", "define ",
        "print(", "write(", "if (", "for (", "while (", "match (",
        "return ", "throw ", "try {", "defer "
    ];
    
    for (pattern in patterns) {
        if (text.starts_with(pattern)) {
            return true;
        }
    }
    
    return false;
}

// Categorize an error based on the output message.
// Returns: "syntax", "runtime", "logic", or "unknown"
export fn categorize_error(result) {
    let output = result.output ?? "";
    
    // Syntax errors typically mention parse errors, unexpected tokens, etc.
    // Check for common syntax error keywords (case-sensitive, but covers common cases)
    if (output.contains("parse") || output.contains("Parse") || 
        output.contains("syntax") || output.contains("Syntax") ||
        output.contains("unexpected") || output.contains("Unexpected") ||
        output.contains("expected") || output.contains("Expected") ||
        output.contains("Error at") || output.contains("missing") || 
        output.contains("Missing") || output.contains("Expect")) {
        return "syntax";
    }
    
    // Runtime errors mention things like null dereference, index out of bounds, etc.
    if (output.contains("null") || output.contains("Null") ||
        output.contains("index") || output.contains("Index") ||
        output.contains("bounds") || output.contains("Bounds") ||
        output.contains("undefined") || output.contains("Undefined") ||
        output.contains("cannot read") || output.contains("Cannot read") ||
        output.contains("does not have") || output.contains("Does not have")) {
        return "runtime";
    }
    
    // Logic errors are everything else - wrong output, assertion failures, etc.
    if (result.exit_code != 0) {
        return "logic";
    }
    
    return "unknown";
}

// Shared tail of a retry-feedback message: exit code, output, and a
// category-specific hint.
fn feedback_body(result) {
    let output = result.output ?? "";
    let error_type = categorize_error(result);

    let hint = "";
    if (error_type == "syntax") {
        hint = "This is a syntax error. Check Hemlock syntax rules: semicolons are required, use template strings for interpolation, and remember that / always does floating-point division.";
    } else if (error_type == "runtime") {
        hint = "This is a runtime error. Check for null values, array bounds, and whether objects have the properties you're accessing.";
    } else if (error_type == "logic") {
        hint = "The code runs but produces incorrect output. Review the logic and try again.";
    }

    return `Exit code ${result.exit_code}.\n\nOutput:\n${output}\n\n${hint}\n\nPlease fix and try again.`;
}

// Build a short feedback message the agent can send back to the model
// after running extracted code. `result` should have `exit_code` and `output`.
// Assumes the failing code is already in the conversation (the model's own
// previous reply).
export fn build_retry_feedback(result) {
    return `That code failed when I ran it. ` + feedback_body(result);
}

// Variant that quotes the failing code itself. Used when the failed attempt
// was a cold resample: its code never entered the persistent conversation,
// so a plain "that code failed" would refer to code the model has never seen.
export fn build_retry_feedback_with_code(result, code) {
    return `This code failed when I ran it:\n\n\`\`\`hemlock\n${code}\n\`\`\`\n\n` + feedback_body(result);
}

// Parse one pass of an OpenAI-style SSE chunk-buffer into its finished events,
// returning { events: [delta_strings...], done: bool, remainder: string }.
//
// The caller feeds raw bytes from `post_json_stream.read()` into an accumulator
// and calls this to drain whatever complete events are now present. Anything
// incomplete (e.g. a partial "data: " line with no blank-line terminator yet)
// stays in `remainder` for the next pass.
//
// Each SSE event looks like:
//
//   data: {"choices":[{"delta":{"content":"Hello"}}]}
//   \n
//
// Terminator is the literal line `data: [DONE]`.
export fn parse_sse_events(buffer: string): object {
    let events = [];
    let done = false;
    let cursor = 0;
    let len = buffer.length;

    while (cursor < len) {
        // An event ends at a blank line (\n\n or \r\n\r\n).
        let rest = buffer.slice(cursor);
        let nn = rest.find("\n\n");
        let rnrn = rest.find("\r\n\r\n");
        let end = -1;
        let skip = 0;
        if (rnrn >= 0 && (nn < 0 || rnrn < nn)) {
            end = rnrn;
            skip = 4;
        } else if (nn >= 0) {
            end = nn;
            skip = 2;
        }
        if (end < 0) { break; }  // incomplete event, wait for more bytes

        let event_str = rest.slice(0, end);
        cursor = cursor + end + skip;

        // An event may contain multiple `data:` lines that are concatenated.
        let data_parts = [];
        let lines = event_str.split("\n");
        for (line in lines) {
            if (line.length > 0 && line.ends_with("\r")) {
                line = line.slice(0, line.length - 1);
            }
            if (line.starts_with("data: ")) {
                data_parts.push(line.slice(6));
            } else if (line.starts_with("data:")) {
                data_parts.push(line.slice(5));
            }
        }
        if (data_parts.length == 0) { continue; }

        let data = data_parts.join("\n");
        if (data == "[DONE]") {
            done = true;
            break;
        }
        events.push(data);
    }

    return {
        events: events,
        done: done,
        remainder: buffer.slice(cursor),
    };
}

// Extract the token text delta from one OpenAI-format JSON payload.
// Payload example:
//   {"choices":[{"delta":{"content":"Hello"}}]}
// Returns the content string, or "" if the payload doesn't carry a delta.
// `json_parse` is injected so this module stays free of stdlib coupling.
export fn parse_openai_delta(payload_str: string, json_parse): string {
    try {
        let obj = json_parse(payload_str);
        let choices = obj.choices;
        if (choices == null || choices.length == 0) { return ""; }
        let delta = choices[0].delta;
        if (delta == null) { return ""; }
        let content = delta.content;
        if (content == null) { return ""; }
        return content;
    } catch (e) {
        return "";
    }
}
