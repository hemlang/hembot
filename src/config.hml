// Configuration parsing for Hembot.
// Reads from CLI arguments (parsed via @stdlib/args) and applies defaults.

import * as cli from "@stdlib/args";

export let DEFAULT_URL = "http://127.0.0.1:8199/v1/chat/completions";
export let DEFAULT_SYSTEM_PROMPT = "system_prompt.txt";
export let DEFAULT_MODEL = "local";
export let DEFAULT_TEMPERATURE = 0.2;
export let DEFAULT_MAX_TOKENS = 2048;
export let DEFAULT_TIMEOUT_MS = 120000;
export let DEFAULT_MAX_RETRIES = 3;
export let DEFAULT_SERVE_HOST = "127.0.0.1";
export let DEFAULT_SERVE_PORT = 8080;
export let DEFAULT_UI_FILE = "web/index.html";
export let DEFAULT_MAX_STEPS = 12;

// String options that take a value: `--url http://...` instead of
// being parsed as a flag plus a positional argument.
export let CLI_STRING_OPTIONS = ["url", "model", "system", "host", "port", "ui", "project", "max-steps", "record", "verify"];

export fn parse_cli(argv) {
    return cli.parse(argv, { strings: CLI_STRING_OPTIONS });
}

export fn load_config(parsed) {
    return {
        url: cli.get_option(parsed, "url") ?? DEFAULT_URL,
        system_prompt_file: cli.get_option(parsed, "system") ?? DEFAULT_SYSTEM_PROMPT,
        model: cli.get_option(parsed, "model") ?? DEFAULT_MODEL,
        temperature: DEFAULT_TEMPERATURE,
        max_tokens: DEFAULT_MAX_TOKENS,
        timeout_ms: DEFAULT_TIMEOUT_MS,
        run_code: !cli.has_flag(parsed, "no-exec"),
        auto_retry: cli.has_flag(parsed, "retry"),
        max_retries: DEFAULT_MAX_RETRIES,
        // Streaming is on by default; `--no-stream` falls back to a single
        // blocking POST that returns the whole response at once.
        stream: !cli.has_flag(parsed, "no-stream"),
        // Generation feedback (spinner while waiting + a timing line after) is
        // on by default; `--no-spinner` silences it for clean scripted output.
        spinner: !cli.has_flag(parsed, "no-spinner"),
        // `--serve` runs an HTTP API instead of the interactive loop.
        serve: cli.has_flag(parsed, "serve"),
        serve_host: cli.get_option(parsed, "host") ?? DEFAULT_SERVE_HOST,
        serve_port: i32(cli.get_option(parsed, "port") ?? `${DEFAULT_SERVE_PORT}`),
        // Web UI served at GET / when this file exists; `--no-ui` disables it.
        ui_file: cli.get_option(parsed, "ui") ?? DEFAULT_UI_FILE,
        ui_enabled: !cli.has_flag(parsed, "no-ui"),
        // `--project <dir>` runs the multi-file agent over a repo.
        project_dir: cli.get_option(parsed, "project"),
        max_steps: i32(cli.get_option(parsed, "max-steps") ?? `${DEFAULT_MAX_STEPS}`),
        // `--whole-file`: edit by rewriting whole files (@write) instead of
        // search/replace — slower / more tokens, but more accurate for weaker
        // models that can't reproduce exact SEARCH blocks.
        whole_file: cli.has_flag(parsed, "whole-file"),
        // `--record <jsonl>` logs each task's trajectory (for training data).
        // `--verify "<cmd>"` is run after a task to judge success.
        record_file: cli.get_option(parsed, "record"),
        verify_cmd: cli.get_option(parsed, "verify"),
    };
}
